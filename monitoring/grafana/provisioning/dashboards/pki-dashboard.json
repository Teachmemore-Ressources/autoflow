{
  "title": "Autoflow PKI — Certificate Authority",
  "uid": "autoflow-pki",
  "tags": ["pki", "certificates", "autoflow"],
  "timezone": "browser",
  "refresh": "1m",
  "schemaVersion": 38,
  "panels": [
    {
      "id": 1, "type": "stat", "title": "Total Certificates",
      "gridPos": {"h": 4, "w": 4, "x": 0, "y": 0},
      "targets": [{"expr": "pki_certificates_total", "legendFormat": "Total"}],
      "options": {"colorMode": "value", "graphMode": "none"},
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "thresholds": {"steps": [{"color": "blue"}]}}}
    },
    {
      "id": 2, "type": "stat", "title": "Active Certificates",
      "gridPos": {"h": 4, "w": 4, "x": 4, "y": 0},
      "targets": [{"expr": "pki_certificates_active", "legendFormat": "Active"}],
      "options": {"colorMode": "value", "graphMode": "none"},
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "thresholds": {"steps": [{"color": "green"}]}}}
    },
    {
      "id": 3, "type": "stat", "title": "Expiring within 7 days",
      "gridPos": {"h": 4, "w": 4, "x": 8, "y": 0},
      "targets": [{"expr": "pki_certificates_expiring_7d", "legendFormat": "7d"}],
      "options": {"colorMode": "background", "graphMode": "none"},
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "thresholds": {"steps": [{"color": "green", "value": 0}, {"color": "red", "value": 1}]}}}
    },
    {
      "id": 4, "type": "stat", "title": "Expiring within 30 days",
      "gridPos": {"h": 4, "w": 4, "x": 12, "y": 0},
      "targets": [{"expr": "pki_certificates_expiring_30d", "legendFormat": "30d"}],
      "options": {"colorMode": "background", "graphMode": "none"},
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "thresholds": {"steps": [{"color": "green", "value": 0}, {"color": "orange", "value": 1}]}}}
    },
    {
      "id": 5, "type": "stat", "title": "Revoked Certificates",
      "gridPos": {"h": 4, "w": 4, "x": 16, "y": 0},
      "targets": [{"expr": "pki_certificates_revoked_total", "legendFormat": "Revoked"}],
      "options": {"colorMode": "value", "graphMode": "none"},
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "thresholds": {"steps": [{"color": "text"}]}}}
    },
    {
      "id": 6, "type": "stat", "title": "Expired Certificates",
      "gridPos": {"h": 4, "w": 4, "x": 20, "y": 0},
      "targets": [{"expr": "pki_certificates_expired_total", "legendFormat": "Expired"}],
      "options": {"colorMode": "value", "graphMode": "none"},
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "thresholds": {"steps": [{"color": "text"}, {"color": "orange", "value": 1}]}}}
    },
    {
      "id": 10, "type": "timeseries", "title": "Certificate Activity Over Time",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
      "targets": [
        {"expr": "pki_certificates_active", "legendFormat": "Active"},
        {"expr": "pki_certificates_expiring_30d", "legendFormat": "Expiring 30d"},
        {"expr": "pki_certificates_expiring_7d", "legendFormat": "Expiring 7d"},
        {"expr": "pki_certificates_revoked_total", "legendFormat": "Revoked"}
      ],
      "options": {"tooltip": {"mode": "multi"}},
      "fieldConfig": {"defaults": {"custom": {"lineWidth": 2, "fillOpacity": 10}}}
    },
    {
      "id": 11, "type": "timeseries", "title": "Certificate Operations (Issuance / Revocation / Renewal)",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4},
      "targets": [
        {"expr": "rate(pki_certificate_issues_total[5m])", "legendFormat": "Issues/s"},
        {"expr": "rate(pki_certificate_revocations_total[5m])", "legendFormat": "Revocations/s"},
        {"expr": "rate(pki_certificate_renewals_total[5m])", "legendFormat": "Renewals/s"}
      ],
      "fieldConfig": {"defaults": {"custom": {"lineWidth": 2, "fillOpacity": 8}}}
    },
    {
      "id": 20, "type": "gauge", "title": "CA Certificate Expiry (days)",
      "gridPos": {"h": 6, "w": 8, "x": 0, "y": 12},
      "targets": [{"expr": "pki_ca_expiry_days", "legendFormat": "{{ca_name}}"}],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "showThresholdLabels": true, "showThresholdMarkers": true},
      "fieldConfig": {"defaults": {"min": 0, "max": 3650, "unit": "d", "color": {"mode": "thresholds"},
        "thresholds": {"steps": [{"color": "red", "value": 0}, {"color": "orange", "value": 90}, {"color": "green", "value": 365}]}}}
    },
    {
      "id": 21, "type": "timeseries", "title": "Issue Latency (p95)",
      "gridPos": {"h": 6, "w": 8, "x": 8, "y": 12},
      "targets": [{"expr": "histogram_quantile(0.95, rate(pki_issue_duration_seconds_bucket[5m]))", "legendFormat": "p95 latency"}],
      "fieldConfig": {"defaults": {"unit": "s", "custom": {"lineWidth": 2}}}
    },
    {
      "id": 22, "type": "timeseries", "title": "Expiring Certificates Trend",
      "gridPos": {"h": 6, "w": 8, "x": 16, "y": 12},
      "targets": [
        {"expr": "pki_certificates_expiring_90d", "legendFormat": "90 days"},
        {"expr": "pki_certificates_expiring_30d", "legendFormat": "30 days"},
        {"expr": "pki_certificates_expiring_7d", "legendFormat": "7 days"}
      ],
      "fieldConfig": {"defaults": {"custom": {"lineWidth": 2, "fillOpacity": 15}}}
    }
  ],
  "templating": {"list": []},
  "time": {"from": "now-24h", "to": "now"}
}
