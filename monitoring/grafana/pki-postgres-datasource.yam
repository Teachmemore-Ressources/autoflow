# monitoring/grafana/provisioning/datasources/pki-postgres.yaml
# Déclaré automatiquement au démarrage de Grafana

apiVersion: 1

datasources:
  - name: PostgreSQL PKI
    type: postgres
    uid: pki-postgres
    url: pki-db:5432
    user: ${POSTGRES_USER}
    secureJsonData:
      password: ${POSTGRES_PASSWORD}
    jsonData:
      database: ${POSTGRES_DB}
      sslmode: disable
      maxOpenConns: 10
      maxIdleConns: 5
      connMaxLifetime: 14400
      postgresVersion: 1600
      timescaledb: false
    editable: false
    isDefault: false
