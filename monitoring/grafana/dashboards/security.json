{
  "uid": "autoflow-security",
  "title": "Security Overview",
  "description": "Trivy CVE scan results and image version status for the Autoflow stack.",
  "schemaVersion": 38,
  "version": 2,
  "refresh": "5m",
  "time": { "from": "now-3h", "to": "now" },
  "timezone": "browser",
  "tags": ["security", "autoflow"],
  "editable": true,
  "graphTooltip": 1,
  "panels": [

    {
      "id": 1,
      "type": "row",
      "title": "Security Summary",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
    },

    {
      "id": 2,
      "title": "Critical CVEs",
      "description": "Total CRITICAL vulnerabilities across all scanned images",
      "type": "stat",
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(trivy_vulnerabilities_total{severity=\"CRITICAL\"}) or vector(0)",
          "instant": true,
          "legendFormat": "__auto"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red",   "value": 1 }
            ]
          },
          "color": { "mode": "thresholds" }
        }
      }
    },

    {
      "id": 3,
      "title": "High CVEs",
      "description": "Total HIGH vulnerabilities across all scanned images",
      "type": "stat",
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(trivy_vulnerabilities_total{severity=\"HIGH\"}) or vector(0)",
          "instant": true,
          "legendFormat": "__auto"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null },
              { "color": "orange", "value": 1 },
              { "color": "red",    "value": 10 }
            ]
          },
          "color": { "mode": "thresholds" }
        }
      }
    },

    {
      "id": 4,
      "title": "Outdated Images",
      "description": "Images running behind latest available version (pinned to semver only)",
      "type": "stat",
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(image_version_outdated) or vector(0)",
          "instant": true,
          "legendFormat": "__auto"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null },
              { "color": "orange", "value": 1 }
            ]
          },
          "color": { "mode": "thresholds" }
        }
      }
    },

    {
      "id": 5,
      "title": "Scanner Health",
      "description": "1 = last full scan cycle succeeded",
      "type": "stat",
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "security_scanner_healthy",
          "instant": true,
          "legendFormat": "__auto"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "1": { "text": "UP",   "color": "green" } } },
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red"   } } }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red",   "value": null },
              { "color": "green", "value": 1 }
            ]
          },
          "color": { "mode": "thresholds" }
        }
      }
    },

    {
      "id": 10,
      "type": "row",
      "title": "Vulnerability Breakdown",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 6 }
    },

    {
      "id": 11,
      "title": "CVEs by Image — CRITICAL & HIGH",
      "description": "Horizontal bar gauge: CRITICAL + HIGH vulnerabilities per image",
      "type": "bargauge",
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "trivy_vulnerabilities_total{severity=\"CRITICAL\"}",
          "instant": true,
          "legendFormat": "CRITICAL — {{image}}"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "trivy_vulnerabilities_total{severity=\"HIGH\"}",
          "instant": true,
          "legendFormat": "HIGH — {{image}}"
        }
      ],
      "options": {
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "displayMode": "gradient",
        "valueMode": "color",
        "showUnfilled": true,
        "minVizWidth": 0,
        "minVizHeight": 16,
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",   "value": null },
              { "color": "yellow",  "value": 1 },
              { "color": "orange",  "value": 5 },
              { "color": "red",     "value": 10 }
            ]
          },
          "color": { "mode": "thresholds" },
          "min": 0
        },
        "overrides": [
          {
            "matcher": { "id": "byRegexp", "options": "^CRITICAL" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "dark-red" } }
            ]
          },
          {
            "matcher": { "id": "byRegexp", "options": "^HIGH" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }
            ]
          }
        ]
      }
    },

    {
      "id": 12,
      "title": "All CVEs by Severity — Current Count",
      "description": "Current vulnerability count per image and severity (instant snapshot)",
      "type": "table",
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "trivy_vulnerabilities_total > 0",
          "instant": true,
          "format": "table",
          "legendFormat": "__auto"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "instance": true,
              "job": true
            },
            "renameByName": {
              "image":    "Image",
              "tag":      "Tag",
              "severity": "Severity",
              "Value":    "Count"
            },
            "indexByName": {
              "image": 0, "tag": 1, "severity": 2, "Value": 3
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "fields": [
              { "displayName": "Count", "desc": true }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "displayMode": "auto" }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Severity" },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  { "type": "value", "options": { "CRITICAL": { "text": "🔴 CRITICAL", "color": "dark-red" } } },
                  { "type": "value", "options": { "HIGH":     { "text": "🟠 HIGH",     "color": "orange"  } } },
                  { "type": "value", "options": { "MEDIUM":   { "text": "🟡 MEDIUM",   "color": "yellow"  } } },
                  { "type": "value", "options": { "LOW":      { "text": "🔵 LOW",       "color": "blue"    } } }
                ]
              },
              { "id": "custom.displayMode", "value": "color-text" }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Count" },
            "properties": [
              {
                "id": "custom.displayMode", "value": "color-background"
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "green",  "value": null },
                    { "color": "yellow", "value": 1 },
                    { "color": "orange", "value": 5 },
                    { "color": "red",    "value": 10 }
                  ]
                }
              },
              { "id": "color", "value": { "mode": "thresholds" } }
            ]
          }
        ]
      }
    },

    {
      "id": 13,
      "title": "Critical CVEs Over Time",
      "description": "CRITICAL vulnerability trend per image across scan cycles",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 17 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "trivy_vulnerabilities_total{severity=\"CRITICAL\"}",
          "legendFormat": "{{image}}:{{tag}}"
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "fieldConfig": {
        "defaults": {
          "custom": { "lineWidth": 2, "fillOpacity": 15, "drawStyle": "line", "spanNulls": true },
          "color": { "mode": "fixed", "fixedColor": "dark-red" }
        }
      }
    },

    {
      "id": 14,
      "title": "High + Medium CVEs Over Time",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 17 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "trivy_vulnerabilities_total{severity=\"HIGH\"}",
          "legendFormat": "HIGH — {{image}}"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "trivy_vulnerabilities_total{severity=\"MEDIUM\"}",
          "legendFormat": "MEDIUM — {{image}}"
        }
      ],
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["lastNotNull"] },
        "tooltip": { "mode": "multi" }
      },
      "fieldConfig": {
        "defaults": {
          "custom": { "lineWidth": 1, "fillOpacity": 5, "drawStyle": "line", "spanNulls": true }
        },
        "overrides": [
          {
            "matcher": { "id": "byRegexp", "options": "^HIGH" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }]
          },
          {
            "matcher": { "id": "byRegexp", "options": "^MEDIUM" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "yellow" } }]
          }
        ]
      }
    },

    {
      "id": 20,
      "type": "row",
      "title": "Scan Details",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 25 }
    },

    {
      "id": 21,
      "title": "Last Scan Age per Image",
      "description": "How long ago each image was last scanned — sorted by oldest first",
      "type": "bargauge",
      "gridPos": { "h": 8, "w": 10, "x": 0, "y": 26 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "time() - trivy_last_scan_timestamp_seconds",
          "instant": true,
          "legendFormat": "{{image}}"
        }
      ],
      "options": {
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "displayMode": "gradient",
        "showUnfilled": true
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null },
              { "color": "yellow", "value": 21600 },
              { "color": "red",    "value": 43200 }
            ]
          },
          "color": { "mode": "thresholds" }
        }
      }
    },

    {
      "id": 22,
      "title": "Scan Duration per Image",
      "description": "Wall-clock time of last Trivy scan",
      "type": "bargauge",
      "gridPos": { "h": 8, "w": 8, "x": 10, "y": 26 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "trivy_scan_duration_seconds",
          "instant": true,
          "legendFormat": "{{image}}"
        }
      ],
      "options": {
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "displayMode": "gradient",
        "showUnfilled": true
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null },
              { "color": "yellow", "value": 60 },
              { "color": "orange", "value": 120 }
            ]
          },
          "color": { "mode": "thresholds" }
        }
      }
    },

    {
      "id": 23,
      "title": "Scan Errors Total",
      "type": "stat",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 26 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(trivy_scan_errors_total) or vector(0)",
          "instant": true,
          "legendFormat": "__auto"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red",   "value": 1 }
            ]
          },
          "color": { "mode": "thresholds" }
        }
      }
    },

    {
      "id": 30,
      "type": "row",
      "title": "Image Version Status",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 34 }
    },

    {
      "id": 31,
      "title": "Version Status",
      "description": "Current vs latest version. Images using 'latest' tag are not comparable (shown as UP TO DATE).",
      "type": "table",
      "gridPos": { "h": 9, "w": 16, "x": 0, "y": 35 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "image_version_outdated",
          "instant": true,
          "format": "table",
          "legendFormat": "__auto"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "instance": true,
              "job": true
            },
            "renameByName": {
              "image":           "Image",
              "current_version": "Running",
              "latest_version":  "Latest",
              "Value":           "Status"
            },
            "indexByName": {
              "image": 0, "current_version": 1, "latest_version": 2, "Value": 3
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "displayMode": "auto" }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Status" },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  { "type": "value", "options": { "0": { "text": "✅ UP TO DATE", "color": "green" } } },
                  { "type": "value", "options": { "1": { "text": "🔴 OUTDATED",   "color": "red"   } } }
                ]
              },
              { "id": "custom.displayMode", "value": "color-background" },
              { "id": "color", "value": { "mode": "thresholds" } },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "green", "value": null },
                    { "color": "red",   "value": 1 }
                  ]
                }
              }
            ]
          }
        ]
      }
    },

    {
      "id": 32,
      "title": "Last Version Check",
      "description": "Time since the last version check cycle completed",
      "type": "stat",
      "gridPos": { "h": 4, "w": 8, "x": 16, "y": 35 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "time() - version_last_check_timestamp_seconds",
          "instant": true,
          "legendFormat": "__auto"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null },
              { "color": "yellow", "value": 3600 },
              { "color": "red",    "value": 7200 }
            ]
          },
          "color": { "mode": "thresholds" }
        }
      }
    },

    {
      "id": 33,
      "title": "Version Check Errors",
      "type": "stat",
      "gridPos": { "h": 5, "w": 8, "x": 16, "y": 39 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(version_check_errors_total) or vector(0)",
          "instant": true,
          "legendFormat": "__auto"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red",   "value": 1 }
            ]
          },
          "color": { "mode": "thresholds" }
        }
      }
    },

    {
      "id": 40,
      "type": "row",
      "title": "Scanner Internals",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 44 }
    },

    {
      "id": 41,
      "title": "Scanner HTTP Request Rate",
      "description": "FastAPI request throughput on the security_scanner service",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 24, "x": 0, "y": 45 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(http_request_duration_seconds_count{job=\"security_scanner\"}[5m])",
          "legendFormat": "{{handler}} {{method}}"
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "lineWidth": 1, "fillOpacity": 10, "drawStyle": "line", "spanNulls": true }
        }
      }
    }

  ]
}
