# ─────────────────────────────────────────────────────────────
# Autoflow Environment Configuration
# Copy this file to .env and fill in all required values.
# Never commit .env to version control.
# ─────────────────────────────────────────────────────────────

# ── PostgreSQL ───────────────────────────────────────────────
POSTGRES_DB=awx
POSTGRES_USER=awx
# REQUIRED: set a strong password
POSTGRES_PASSWORD=change_me_postgres

# ── Redis ────────────────────────────────────────────────────
# REQUIRED: set a strong password
REDIS_PASSWORD=change_me_redis

# ── AWX ──────────────────────────────────────────────────────
AWX_VERSION=24.6.1
AWX_ADMIN_USER=admin
# REQUIRED: set a strong password
AWX_ADMIN_PASSWORD=change_me_awx_admin

# ── AWX SSH key management ────────────────────────────────────
# Host path to the SSH key directory — mounted read-only into every EE container.
# Generate the key pair via the Deploy Wizard: GET /api/ssh/generate
# The private key (id_ed25519) is NEVER committed — see .gitignore.
AWX_SSH_DIR=/home/vagrant/autoflow/ssh
# Name of the AWX Machine credential to update on key rotation.
AWX_SSH_CREDENTIAL_NAME=lab-ssh-key
# Name of the AWX Job Template whose extra_vars will be cleaned up on sync.
AWX_CLONE_JT_NAME=[JT] Clone VM Proxmox
AWX_ADMIN_EMAIL=admin@autoflow.local
# REQUIRED: generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
AWX_SECRET_KEY=change_me_awx_secret_key_at_least_50_chars_long

# ── Autoflow API ─────────────────────────────────────────────
# REQUIRED: generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
# Used as X-API-Key header to authenticate requests to the Autoflow API.
API_SECRET_KEY=change_me_api_secret_key

LOG_LEVEL=info

# ── Environment ───────────────────────────────────────────────────────────────
# Controls production-only safety guards in all FastAPI services.
# When ENV=production:
#   - CORS_ORIGINS=* raises a RuntimeError at startup (intentional crash-guard)
#   - Other stricter checks may apply
# Values: development | production
ENV=development

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins for all FastAPI services.
#
# SECURITY: empty string = no origin allowed (safest default).
# In development with a separate frontend:
#   CORS_ORIGINS=http://localhost:3000
# In production:
#   CORS_ORIGINS=https://app.yourdomain.com,https://admin.yourdomain.com
#
# WARNING: CORS_ORIGINS=* is blocked when ENV=production.
CORS_ORIGINS=

# ── Security headers ──────────────────────────────────────────────────────────
# Set to false to disable HTTP security headers in local HTTP-only development.
# Must remain true (default) in production — headers are required for all
# security audits (OWASP, PCI-DSS, ISO 27001).
SECURITY_HEADERS_ENABLED=true

# Rate limiting — requests per IP per period (slowapi format: "<count>/<period>")
# Valid periods: second, minute, hour, day
RATE_LIMIT=100/minute

# AWX job metrics polling interval in seconds (0 = disabled)
AWX_METRICS_INTERVAL=60

# ── JWT Auth ──────────────────────────────────────────────────────────────────
# Credentials used at POST /api/v1/auth/token
# API_PASSWORD defaults to API_SECRET_KEY if left empty (no extra config needed)
API_USERNAME=admin
API_PASSWORD=

# JWT signing secret — defaults to API_SECRET_KEY if left empty
# For production, set a dedicated long random value:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=
JWT_EXPIRE_MINUTES=60

# ── Multi-user RBAC ──────────────────────────────────────────────────────────
# Path to the JSON file containing user accounts.
# On first boot a default admin is created with password = API_SECRET_KEY.
# Manage users via POST /api/v1/users  (admin role required).
# Roles: admin | operator | viewer
USERS_FILE=/etc/autoflow/users.json

# ── JWT Revocation (Redis blacklist) ─────────────────────────────────────────
# Optional.  When set, POST /api/v1/auth/logout stores revoked JTIs in Redis
# so a stolen token can be invalidated immediately (before it expires).
# Uses the same Redis instance as the event-engine.
# Leave empty to disable server-side revocation.
REDIS_URL=redis://redis:6379

# ── Notifications (job completion callbacks) ──────────────────────────────────
# Generic POST webhook called when a watched AWX job reaches terminal status
NOTIFICATION_WEBHOOK_URL=
# Slack incoming webhook (Block Kit message with job status + duration)
NOTIFICATION_SLACK_WEBHOOK=
# AWX polling interval for watched jobs in seconds
JOB_WATCHER_INTERVAL=15

# ── Ports ────────────────────────────────────────────────────
AWX_HTTP_PORT=80
API_PORT=8000
EVENT_ENGINE_PORT=8001
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
ALERTMANAGER_PORT=9093

# ── MinIO (object storage — backend Loki) ────────────────────
# Compte root MinIO (accès console + administration)
# REQUIRED: set a strong password
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me_minio_root

# Compte dédié Loki (readwrite sur loki-chunks uniquement)
# Créé automatiquement par minio_init au premier démarrage.
# REQUIRED: generate with: python3 -c "import secrets; print(secrets.token_hex(16))"
LOKI_S3_ACCESS_KEY=loki
LOKI_S3_SECRET_KEY=change_me_loki_s3_secret

# ── Monitoring ───────────────────────────────────────────────
PROMETHEUS_RETENTION=15d
GRAFANA_ADMIN_USER=admin
# REQUIRED: set a strong password
GRAFANA_ADMIN_PASSWORD=change_me_grafana

# ── Security Scanner ─────────────────────────────────────────
SECURITY_SCANNER_PORT=8002

# Trivy CVE scan interval in seconds (default: 6h). Scans can take 30-120s per image.
SCAN_INTERVAL=21600

# Image version check interval in seconds (default: 1h)
VERSION_CHECK_INTERVAL=3600

# REQUIRED: GID of the Docker socket on the host so the scanner can read it.
# Run: stat -c '%g' /var/run/docker.sock
DOCKER_GID=998

# Trivy image tag used in the multi-stage build (aquasec/trivy:<version>)
TRIVY_VERSION=0.63.0

# Max seconds to wait for a single image scan before aborting
# AWX image is ~2GB; 300s (5min) recommended
TRIVY_TIMEOUT=300

# Optional: GitHub Personal Access Token
# Without it: 60 API requests/hour (sufficient for default 1h check interval)
# With it:    5000 requests/hour
GITHUB_TOKEN=

# Optional: DockerHub credentials (increases tag lookup rate limits)
DOCKERHUB_USER=
DOCKERHUB_PASSWORD=

# ── Event Engine ─────────────────────────────────────────────
# REQUIRED: AWX API token — create in AWX UI: User menu → Tokens → Add
AWX_TOKEN=change_me_awx_api_token
# REQUIRED: ID of the AWX job template to trigger when no rule matches
AWX_JOB_TEMPLATE_ID=1
# Deduplication window in seconds (0 = disabled)
DEDUP_TTL=60
# Optional: GitHub webhook HMAC secret for signature validation
# Set to the same secret configured in GitHub → Settings → Webhooks
# Leave empty to skip signature validation (not recommended for production)
GITHUB_WEBHOOK_SECRET=

# ── Gitea ─────────────────────────────────────────────────────
GITEA_HTTP_PORT=3001
GITEA_SSH_PORT=2222
GITEA_DOMAIN=localhost
GITEA_ROOT_URL=http://localhost:3001
# REQUIRED: generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
GITEA_SECRET_KEY=change_me_gitea_secret
# REQUIRED: generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
GITEA_INTERNAL_TOKEN=change_me_gitea_internal
# Token for Prometheus /metrics endpoint
# REQUIRED: generate with: python3 -c "import secrets; print(secrets.token_hex(16))"
GITEA_METRICS_TOKEN=change_me_metrics_token
# Gitea database (dedicated PostgreSQL instance)
GITEA_DB_NAME=gitea
GITEA_DB_USER=gitea
# REQUIRED: set a strong password
GITEA_DB_PASSWORD=change_me_gitea_db
# Log level: Trace, Debug, Info, Warn, Error
GITEA_LOG_LEVEL=Warn

# ── Gitea Container Registry ──────────────────────────────────
# Token used by AWX to pull EE images from the Gitea registry.
# Generate with: docker exec autoflow_gitea gitea admin user generate-access-token \
#                  --username admin --token-name awx-pull --raw
GITEA_REGISTRY_TOKEN=change_me_gitea_registry_token
#
# The registry is served on the same port as Gitea (GITEA_HTTP_PORT).
# Endpoint (external):         localhost:3001
# Endpoint (intra-stack):      gitea:3001
# Login:                       docker login localhost:3001   (Gitea username/password)
# Push example:                docker tag myimage localhost:3001/<gitea-user>/ee-security:1.0.0
#                              docker push localhost:3001/<gitea-user>/ee-security:1.0.0
# -1 = unlimited (recommended for dev); set in bytes for production (e.g. 10737418240 = 10GB)
GITEA_REGISTRY_OWNER_LIMIT=-1
GITEA_REGISTRY_IMAGE_LIMIT=-1
# Token for Gitea Actions act_runner (auto-populated by: make gitea-init-runner)
GITEA_RUNNER_TOKEN=

# ── EE Builder ────────────────────────────────────────────────
EE_BUILDER_PORT=8003
# Version tag applied to rebuilt EE images (override per-push if needed)
EE_DEFAULT_VERSION=latest
# Gitea user owning the EE images in the registry
GITEA_USER=admin

# ── Compliance & Audit ───────────────────────────────────────
# Bearer token for POST /compliance/report/generate and report download endpoints.
# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
# Must match COMPLIANCE_ADMIN_TOKEN in the security-scanner container.
# Leave empty to disable auth (not recommended for production).
COMPLIANCE_ADMIN_TOKEN=

# ── OpenTelemetry distributed tracing ─────────────────────────
# OTLP endpoint of the OpenTelemetry Collector (all FastAPI services send traces here).
# Default points to the intra-stack collector; change to an external endpoint if needed.
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317

# ── Disaster Recovery (Restic) ────────────────────────────────
# REQUIRED for Restic mode: generate once and store in a password manager.
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Losing this password = losing access to all backups.
BACKUP_RESTIC_PASSWORD=

# Backend: local | sftp | s3 | b2
BACKUP_BACKEND=local

# local backend: absolute path on this host (must exist and be writable)
# sftp backend:  sftp://user@host:port/path
BACKUP_LOCAL_PATH=/var/backups/autoflow/restic

# S3-compatible backend (AWS S3, MinIO, Wasabi, Scaleway, OVH)
# Leave BACKUP_S3_ENDPOINT empty for AWS S3.
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=autoflow-backup
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=

# GFS retention policy
BACKUP_RETENTION_DAILY=7
BACKUP_RETENTION_WEEKLY=4
BACKUP_RETENTION_MONTHLY=12
BACKUP_RETENTION_YEARLY=3

# Cron schedule (default: 2:00 AM daily)
BACKUP_CRON=0 2 * * *

# RTO/RPO objectives (hours) — document your team's SLA
BACKUP_RTO_HOURS=4
BACKUP_RPO_HOURS=24
