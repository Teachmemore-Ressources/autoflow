# ── Secrets & configuration ───────────────────────────────────────────────────
# Plaintext .env — NEVER commit (contient mots de passe, clés secrètes)
.env
# Backups automatiques du .env (contiennent les secrets en clair)
.env.bak.*

# ── TLS / PKI ─────────────────────────────────────────────────────────────────
# Certificats et clés privées (spécifiques au domaine, jamais publics)
*.crt
*.key
*.pem
certs/

# ── Logs & audits ─────────────────────────────────────────────────────────────
*.log

# ── Python — virtualenvs ──────────────────────────────────────────────────────
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/

# ── Docker — artefacts ────────────────────────────────────────────────────────
*.tar

# ── Sauvegardes base de données ───────────────────────────────────────────────
*.sql
*.sql.gz
backups/

# ── Claude Code ───────────────────────────────────────────────────────────────
.claude/settings.local.json
.claude/worktrees/

# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
