# ── Secrets & configuration ───────────────────────────────────────────────────
# Plaintext .env — NEVER commit (use .env.enc chiffré via SOPS+Age)
.env
# Backups automatiques créés par le wizard (contiennent les secrets en clair)
.env.bak.*
# .env du sous-projet community
community/.env

# ── SSH Keys ──────────────────────────────────────────────────────────────────
# Clé privée JAMAIS commitée — la clé publique et le config sont versionables
ssh/id_ed25519
ssh/id_ed25519.bak
ssh/id_ed25519.old
# known_hosts : spécifique à l'environnement, géré dynamiquement
ssh/known_hosts
!ssh/.gitkeep

# ── TLS / PKI ─────────────────────────────────────────────────────────────────
# Clés privées
traefik/certs/*.key
traefik/certs/*.key.bak
# Certificats générés par le wizard (spécifiques au domaine, recréés par pre-flight)
traefik/certs/*.crt
!traefik/certs/.gitkeep
# Fichier d'authentification BasicAuth Traefik (mots de passe hachés)
traefik/dynamic/monitoring_users

# ── Monitoring secrets ────────────────────────────────────────────────────────
monitoring/prometheus/secrets/*
!monitoring/prometheus/secrets/.gitkeep

# ── Logs & audits ─────────────────────────────────────────────────────────────
*.log
wizard-audit.log

# ── Python — virtualenvs ──────────────────────────────────────────────────────
.wizard-venv/
.cli-venv/
.venv/
venv/

# ── Python — cache & build ────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/

# ── Backups ───────────────────────────────────────────────────────────────────
backups/

# ── Claude Code ───────────────────────────────────────────────────────────────
# Paramètres locaux non partageables et worktrees temporaires
.claude/settings.local.json
.claude/worktrees/

# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── MkDocs — site généré (rebuild par CI/CD) ──────────────────────────────────
site/
.cache/
